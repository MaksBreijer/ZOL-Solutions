{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ZOL: Pakketten installeren",
      "type": "shell",
      "command": "npm install",
      "problemMatcher": []
    },
    {
      "label": "ZOL: Website starten",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": ".*Local:.*"
        }
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "ZOL: Productiebuild controleren",
      "type": "npm",
      "script": "build",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
