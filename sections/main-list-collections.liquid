<section class="page-shell">
  <p class="eyebrow">Shop</p>
  <h1 class="page-title">Collections</h1>
  <div class="product-grid">
    {% for collection in collections %}
      <a class="product-card" href="{{ collection.url }}">
        <div class="product-card__media">
          {% if collection.featured_image %}
            {{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: collection.title }}
          {% else %}
            <img src="https://cdn.shopify.com/s/files/1/1020/7107/5153/files/zol-exploded-view-poster.png?v=1781635426" alt="{{ collection.title }}" width="1600" height="900">
          {% endif %}
        </div>
        <h2 class="product-card__title">{{ collection.title }}</h2>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Main list collections",
  "settings": []
}
{% endschema %}
