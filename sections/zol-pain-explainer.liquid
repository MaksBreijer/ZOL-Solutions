<section class="zol-explainer" id="hielpijn">
  <div class="zol-explainer__media">
    <img src="https://zolsolutions.nl/cdn/shop/files/ziekte_van_sever_hielpijn.png?v=1775822547&width=1400" alt="Uitleg over hielpijn en ziekte van Sever bij jonge sporters" width="1400" height="1000">
  </div>
  <div class="zol-explainer__content">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    <div class="zol-explainer__points">
      <span>Groei</span>
      <span>Sportbelasting</span>
      <span>Demping</span>
      <span>Stabiliteit</span>
    </div>
    <a class="pill-link" href="{{ section.settings.link_url }}">{{ section.settings.link_label }}</a>
  </div>
</section>

{% schema %}
{
  "name": "ZOL pain explainer",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Wat is hielpijn?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Als groei en sport botsen, voelt de hiel het eerst."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Bij jonge sporters kunnen harde ondergronden en groeiperiodes extra druk geven op de hiel. ZOL'tjes zijn ontwikkeld om die landing zachter en stabieler te maken."
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Lees meer"
    }
  ],
  "presets": [
    {
      "name": "ZOL pain explainer"
    }
  ]
}
{% endschema %}
