<section class="section" id="technology">
  <div class="section__head">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <div>
      <h2>{{ section.settings.heading }}</h2>
      <p class="section__intro">{{ section.settings.intro }}</p>
    </div>
  </div>

  <div class="capability-grid">
    {% for block in section.blocks %}
      <article class="capability" {{ block.shopify_attributes }}>
        <span class="capability__index">0{{ forloop.index }}</span>
        <div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "ZOL capabilities",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Ons verhaal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "De fundering onder druk?"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Wanneer kinderen hard groeien, kunnen kunstgras, gravel en zaalvloeren intensief zijn voor de hielen. ZOL combineert demping met stabiliteit."
    }
  ],
  "blocks": [
    {
      "type": "capability",
      "name": "Capability",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Support"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Layered support zones that make the product story easy to scan."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ZOL capabilities",
      "blocks": [
        {
          "type": "capability",
          "settings": {
            "title": "Hielpijn",
            "text": "Gericht op jonge sporters die last hebben van hun hielen tijdens groei en intensieve belasting."
          }
        },
        {
          "type": "capability",
          "settings": {
            "title": "Ready to go",
            "text": "Direct klaar voor gebruik en makkelijk te verwisselen tussen schoenen."
          }
        },
        {
          "type": "capability",
          "settings": {
            "title": "Demping",
            "text": "Een zachte, stabiele basis die ondersteuning en comfort zichtbaar maakt."
          }
        }
      ]
    }
  ]
}
{% endschema %}
