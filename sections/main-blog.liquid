<section class="page-shell">
  <p class="eyebrow">Blogs</p>
  <h1 class="page-title">{{ blog.title }}</h1>
  {% paginate blog.articles by 9 %}
    <div class="product-grid">
      {% for article in blog.articles %}
        <a class="product-card" href="{{ article.url }}">
          <div class="product-card__media">
            {% if article.image %}
              {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: article.title }}
            {% else %}
              <img src="https://zolsolutions.nl/cdn/shop/files/ziekte_van_sever_hielpijn.png?v=1775822547&width=900" alt="{{ article.title }}" width="900" height="900">
            {% endif %}
          </div>
          <h2 class="product-card__title">{{ article.title }}</h2>
          <p>{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
        </a>
      {% endfor %}
    </div>
    {{ paginate | default_pagination }}
  {% endpaginate %}
</section>

{% schema %}
{
  "name": "Main blog",
  "settings": []
}
{% endschema %}
