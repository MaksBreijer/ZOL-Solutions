<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {% if settings.logo != blank %}
        {{ settings.logo | image_url: width: 220 | image_tag: loading: 'eager', alt: shop.name }}
      {% else %}
        <span class="brand__mark">ZOL</span> Solutions
      {% endif %}
    </a>

    <nav class="nav" aria-label="Main navigation">
      <a href="{{ routes.root_url }}">Home</a>
      <a href="/products/zol-inlegzolen-voor-kinderen-met-hielpijn">Shop nu</a>
      <a href="/pages/over-ons">Over ons</a>
      <a href="/pages/contact">Contact</a>
      <a href="/blogs/news">Blogs</a>
    </nav>

    <div class="site-header__actions">
      <a class="pill-link" href="{{ routes.cart_url }}">Cart ({{ cart.item_count }})</a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
