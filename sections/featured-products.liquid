<section class="featured-products">
  <div class="section">
    <div class="section__head">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <div>
        <h2>{{ section.settings.heading }}</h2>
        <p class="section__intro">{{ section.settings.intro }}</p>
      </div>
    </div>

    <div class="product-grid">
      {% assign featured_collection = section.settings.collection %}
      {% if featured_collection != blank and featured_collection.products_count > 0 %}
        {% for product in featured_collection.products limit: 3 %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% else %}
        {% for i in (1..3) %}
          <article class="product-card">
            <div class="product-card__media">
              <img src="https://cdn.shopify.com/s/files/1/1020/7107/5153/files/zol-exploded-view-poster.png?v=1781635426" alt="ZOL concept" width="1600" height="900">
            </div>
            <h3 class="product-card__title">ZOL Concept {{ i }}</h3>
            <span class="product-card__price">Coming soon</span>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "De ZOL'tjes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Klaar om weer te bewegen"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Voor kinderen tussen 8 en 15 jaar die comfortabel willen blijven sporten."
    }
  ],
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}
